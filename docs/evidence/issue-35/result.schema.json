{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GowthamTG/anthriq/docs/evidence/issue-35/result.schema.json",
  "title": "SCOPE persisted-preview evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "createdAt", "environment", "recordingRoot", "states", "result"],
  "properties": {
    "format": { "const": "SCOPE-PREVIEW-EVIDENCE/1" },
    "createdAt": { "type": "string" },
    "environment": { "type": "object" },
    "recordingRoot": { "type": "string" },
    "result": { "const": "PASS" },
    "states": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "label",
          "lifecycle",
          "availability",
          "channels",
          "bucketFrames",
          "capacity",
          "persistedFrames",
          "physicalBytesAtRead",
          "originalFrameWindow",
          "unavailablePersistedFrameRange",
          "physicalGapCount",
          "visibleGapCount",
          "buckets"
        ],
        "properties": {
          "label": { "type": "string" },
          "lifecycle": { "enum": ["recording", "stopping", "completed", "failed"] },
          "availability": { "const": "available" },
          "channels": { "type": "array", "minItems": 1, "maxItems": 4 },
          "bucketFrames": { "type": "integer", "minimum": 1 },
          "capacity": { "type": "integer", "minimum": 1 },
          "persistedFrames": { "type": "integer", "minimum": 1 },
          "physicalBytesAtRead": { "type": "integer", "minimum": 1 },
          "originalFrameWindow": { "type": "object" },
          "unavailablePersistedFrameRange": { "type": ["object", "null"] },
          "physicalGapCount": { "type": "integer", "minimum": 0 },
          "visibleGapCount": { "type": "integer", "minimum": 0 },
          "buckets": { "type": "array", "minItems": 1 }
        }
      }
    }
  }
}
