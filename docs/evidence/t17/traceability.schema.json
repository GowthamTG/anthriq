{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "result",
    "source",
    "pdfRequirements",
    "acceptanceScenarios",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "SCOPE-T17-TRACEABILITY/1" },
    "result": { "const": "PASS" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "pages", "sha256", "auditedAt"],
      "properties": {
        "title": { "const": "Technical Assessment: Streaming Signal Capture and Playback" },
        "pages": { "const": 3 },
        "sha256": { "type": "string" },
        "auditedAt": { "type": "string" }
      }
    },
    "pdfRequirements": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "items": { "$ref": "#/$defs/entry" }
    },
    "acceptanceScenarios": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/entry" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "impact", "rationale", "nextWork"],
        "properties": {
          "name": { "type": "string" },
          "impact": { "type": "string" },
          "rationale": { "type": "string" },
          "nextWork": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "status",
        "implementation",
        "tests",
        "evidence",
        "reproductionCommand",
        "demoTimestamp"
      ],
      "properties": {
        "id": { "type": "string" },
        "requirement": { "type": "string" },
        "status": { "enum": ["verified", "documented-limitation"] },
        "implementation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "reproductionCommand": { "type": "string" },
        "demoTimestamp": { "type": ["string", "null"] }
      }
    }
  }
}
