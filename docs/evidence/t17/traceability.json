  "limitations": [
    {
      "name": "General-purpose operating system",
      "impact": "Scheduling and playback are measured but are not hard real-time guarantees.",
      "rationale": "The assessment asks for observed pacing; macOS and Node.js do not provide deterministic real-time scheduling.",
      "nextWork": "Use a real-time host and hardware clock if hard deadlines become a product requirement."
    },
    {
      "name": "Frame-major channel reads",
      "impact": "Channel-subset retrieval reads unselected channel payload within matching frames.",
      "rationale": "The layout keeps acquisition, recovery, and binary seeking simple; measured amplification is disclosed.",
      "nextWork": "Evaluate a versioned channel-blocked or columnar format for channel-heavy analytical workloads."
    },
    {
      "name": "Local single-owner workbench",
      "impact": "One acquisition and one playback session run on one host; there is no authentication or distributed coordination.",
      "rationale": "Remote services and multi-user scope are not required by the assessment.",
      "nextWork": "Add explicit identity, authorization, and remote durable storage only for a defined hosted product."
    },
    {
      "name": "Crash durability",
      "impact": "Clean stop syncs accepted files, but sudden power loss and arbitrary corruption are detected rather than automatically repaired.",
      "rationale": "Power-loss transactions and repair are outside the assessment and would materially expand the storage protocol.",
      "nextWork": "Add checksummed segments, recovery journals, and atomic bundle manifests if required."
    },
    {
      "name": "Validated platforms",
      "impact": "Measurements are from the recorded macOS/Apple M5 Pro environment; CI verifies Ubuntu behavior but not sustained equivalence.",
      "rationale": "The repository does not claim unmeasured cross-platform performance.",
      "nextWork": "Repeat sustained evidence on each supported deployment platform."
    },
    {
      "name": "Forward-only variable rate",
      "impact": "Playback supports slower and faster positive multiples, not reverse chronological playback.",
      "rationale": "The PDF's 'slower and faster directions' is interpreted as multiples below and above native speed; the requirement does not explicitly request reverse playback.",
      "nextWork": "Add reverse indexed playback only if clarified as a product requirement."
    }
  ]
}
